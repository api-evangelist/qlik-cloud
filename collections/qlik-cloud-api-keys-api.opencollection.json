{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qlik Cloud REST Api Keys API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Api Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List API keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-tenant.region.qlikcloud.com/api/v1/api-keys"
          },
          "docs": "List API keys"
        },
        {
          "info": {
            "name": "Create API key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://your-tenant.region.qlikcloud.com/api/v1/api-keys",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create API key"
        }
      ]
    }
  ],
  "bundled": true
}